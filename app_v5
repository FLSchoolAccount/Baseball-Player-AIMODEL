                    if history_df.empty:
                        st.warning(f"No historical OVR data found for {chosen_name}.")
                    else:
                        st.dataframe(history_df, use_container_width=True)

                        fig = go.Figure()
                        fig.add_trace(go.Scatter(
                            x=history_df["Season"], y=history_df["Formula_OVR"],
